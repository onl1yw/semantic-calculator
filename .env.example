# All defaults work locally. Copy to .env only if you need overrides.
# scripts/dev.sh reads these variables from the shell, not from this file.
SC_DATA_DIR=./data/dictionary-word2vec-nouns
SC_SEARCH_CONCURRENCY=2
SC_SEARCH_TIMEOUT=2
SC_IP_PER_MINUTE=120
SC_GLOBAL_PER_MINUTE=1200
SC_GLOBAL_SEARCH_PER_MINUTE=240

# Production uses YDB for words and an image-bundled snapshot for exact search.
# SC_STORE_BACKEND=ydb
# SC_VERIFY_DICTIONARY=true
# SC_YDB_ENDPOINT=grpcs://your-serverless-ydb-endpoint:2135
# SC_YDB_DATABASE=/ru-central1/your-cloud-id/your-database-id
# SC_YDB_QUERY_TIMEOUT=1
# In Yandex Containers, use the attached runtime account (no key files).
# YDB_METADATA_CREDENTIALS=1
